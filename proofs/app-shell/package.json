{
  "name": "officepress-proof-app-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "plugins": [
    "./plugins/app/plugin",
    "./plugins/store/plugin",
    "stackpress-schema",
    "./plugins/auth/plugin",
    "./plugins/settings/theme/plugin",
    "./plugins/settings/about/plugin",
    "./.fixtures/actions/plugin",
    "./plugins/agent/plugin",
    "./plugins/settings/shell/plugin",
    "./.fixtures/plugin"
  ],
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "dev": "node --import tsx scripts/develop.ts",
    "prove": "node --import tsx scripts/prove.ts",
    "typecheck": "tsc --noEmit",
    "generate": "node --import tsx scripts/generate.ts",
    "serve": "node --import tsx scripts/serve.ts",
    "init:proof": "node --import tsx scripts/init-proof.ts",
    "prove:config": "node --import tsx scripts/prove-config.ts --final-build",
    "prove:postgres": "node --import tsx scripts/prove-postgres.ts",
    "prove:identity": "node --import tsx scripts/prove-identity.ts",
    "prove:agent-context": "node --import tsx scripts/prove-agent-context.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@stackpress/ingest": "0.10.8",
    "@stackpress/inquire": "0.10.8",
    "@stackpress/inquire-pg": "0.10.8",
    "@stackpress/inquire-pglite": "0.10.8",
    "@stackpress/lib": "0.10.8",
    "frui": "0.2.9",
    "marked": "15.0.12",
    "pg": "8.16.3",
    "r22n": "1.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "semver": "7.7.3",
    "stackpress-csrf": "0.10.8",
    "stackpress-email": "0.10.8",
    "stackpress-language": "0.10.8",
    "stackpress-schema": "0.10.8",
    "stackpress-server": "0.10.8",
    "stackpress-session": "0.10.8",
    "stackpress-sql": "0.10.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.1.4",
    "playwright": "1.56.1",
    "prettier": "3.8.1",
    "reactus": "0.10.8",
    "ts-morph": "27.0.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "unocss": "66.6.6",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.0.3"
  },
  "description": "Bounded OfficePress app-shell proof"
}
