# The proof explicitly loads repository-root .env, not this file.
# Use your environment manager or node --env-file when supplying local overrides.
# OPENROUTER_TEST_KEY=server-only-key
# PROOF_SESSION_SEED=private-random-string-at-least-32-characters
# PROOF_DATABASE_SEED=persistent-private-identifier-encryption-seed
# OFFICEPRESS_APP_ID=shell-proof
# OFFICEPRESS_FAMILY=operate
# OFFICEPRESS_AGENT=off
# OFFICEPRESS_NOTIFICATIONS=off
# OFFICEPRESS_DISABLED_PLUGINS=agent
# OFFICEPRESS_RELEASE_REPOSITORY=officepress/officepress
# PGLITE_DIR=./.build/database/pglite
# DATABASE_ADAPTER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/officepress
# HOST=127.0.0.1
# PORT=3020
