{
  "compilerOptions": {
    "allowJs": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "module": "nodenext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "removeComments": true,
    "sourceMap": false,
    "target": "es2022",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "config/**/*.ts",
    "tests/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests/evidence"
  ]
}
